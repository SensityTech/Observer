{
    "name": "observer-panel",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "oxlint --deny-warnings src e2e",
        "format": "prettier --write .",
